{
  "schema_version": 2,
  "contract_id": "service-operations-requests",
  "effective_date": "2026-08-29",
  "grain": "One row per service request",
  "required_columns": [
    "request_id","created_at","closed_at","status","priority","category","subcategory","location","team","owner","channel","sla_hours","resolution_hours","reopened","satisfaction_score","last_updated_at","source_system"
  ],
  "controlled_values": {
    "status": ["Open","In Progress","Pending Customer","Closed"],
    "priority": ["Low","Normal","High","Critical"],
    "category": ["Account Access","Billing & Payments","Delivery & Fulfillment","Equipment & Maintenance","Permit & Compliance","General Inquiry"]
  },
  "blocking_rules": ["required-id","valid-created","chronology","valid-resolution","unique-id","known-category","valid-sla"],
  "freshness": {
    "ingestion_slo_minutes": 360,
    "source_snapshot_note": "Synthetic demo records intentionally represent a fixed reporting cycle; ingestion freshness is monitored separately from record-event age."
  },
  "drift_policy": {
    "missing_required_columns": "reject",
    "unexpected_columns": "accept_and_flag",
    "unknown_controlled_values": "quarantine_or_flag_per_rule"
  }
}
